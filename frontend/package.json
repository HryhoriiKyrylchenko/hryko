{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "generate:blog": "tsx scripts/generate-blog-index.ts",
    "start": "ng serve",
    "build": "ng build",
    "build:pages": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "deploy": "ng build --configuration production && npx angular-cli-ghpages --dir=dist/frontend"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.10.1",
  "dependencies": {
    "@angular/cdk": "~21.2.3",
    "@angular/common": "^21.2.5",
    "@angular/compiler": "^21.2.5",
    "@angular/core": "^21.2.5",
    "@angular/forms": "^21.2.5",
    "@angular/material": "~21.2.3",
    "@angular/platform-browser": "^21.2.5",
    "@angular/router": "^21.2.5",
    "fast-glob": "^3.3.3",
    "front-matter": "^4.0.2",
    "marked": "^17.0.6",
    "ngx-markdown": "^21.2.0",
    "reading-time": "^1.5.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.3",
    "@angular/cli": "^21.2.3",
    "@angular/compiler-cli": "^21.2.5",
    "@jsverse/transloco": "^8.2.1",
    "install": "^0.13.0",
    "jsdom": "^27.1.0",
    "npm": "^11.12.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
